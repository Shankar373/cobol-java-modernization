# Git ignore for cobj pipeline PoC
target/
!target/*.md
!target/manifest.json

# Exclude generated binaries and Java source
legacy/bin/
legacy/generated/
legacy/data/out/*
!legacy/data/out/.gitkeep
legacy/data/work/*
!legacy/data/work/.gitkeep
tests/out/
workspace/

# Python cache
__pycache__/
*.pyc

# Local config overrides
.env
.idea/
.vscode/
