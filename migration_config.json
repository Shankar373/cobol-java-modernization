{
  "repo": "legacy",
  "out": "target",
  "format": "free",
  "legacy_exclude_sources": ["CCLEGACYX.cob"],
  "compare": {
    "output_dirs": ["data/out", "data/work"],
    "modes": {
      "data/out/eod-claims-report.txt": "normalized"
    },
    "checks": [
      {
        "file": "data/out/claim-audit.dat",
        "kind": "comp3",
        "sep": "|",
        "field": 3,
        "byte_len": 7,
        "expect": ["95000.00", "35000.00", "295000.00", "300000.00"]
      },
      {
        "file": "data/out/eod-claims-report.txt",
        "kind": "regex",
        "regex": "(?m)^AUDIT RECORDS\\s*:\\s*(\\d+)",
        "expect": "4"
      },
      {
        "file": "data/out/eod-claims-report.txt",
        "kind": "regex",
        "regex": "(?m)^EXCEPTIONS\\s*:\\s*(\\d+)",
        "expect": "3"
      },
      {
        "file": "data/out/eod-claims-report.txt",
        "kind": "regex",
        "regex": "(?m)^MANUAL REVIEWS\\s*:\\s*(\\d+)",
        "expect": "2"
      }
    ]
  }
}