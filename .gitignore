# Git ignore for COBOL -> Java Modernization Platform

# Build targets and outputs
target/
target_*/
generated/
test_out/
acceptance_logs/
tests/out/
workspace/
someout/

# Legacy generated artifacts
legacy/bin/
legacy/generated/
legacy/data/out/*
!legacy/data/out/.gitkeep
legacy/data/work/*
!legacy/data/work/.gitkeep
legacy/_preprocessed/

# Python caches and virtualenvs
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.env
.venv
env/
venv/

# IDE and Editor configurations
.idea/
.vscode/
.gemini/
*.swp
*.swo

# Runtime logs
*.log
ui-server.log
ui-server.err.log
run_*.log

# Compiled binaries and bytecode
*.exe
*.so
*.dll
*.class
*.dat
temp_*

# Scratch directory
scratch/
