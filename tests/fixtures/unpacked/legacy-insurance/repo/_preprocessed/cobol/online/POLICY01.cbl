      *> WHERE POLICY_ID = :POLICY-ID
      *> END-EXEC.
           CONTINUE.
      *> [PREPROCESSED: CICS stub]
      *> EXEC CICS SEND MAP('POLICYMP') END-EXEC.
           CONTINUE.
