       EXEC SQL
           DECLARE C1 CURSOR FOR
             SELECT ACCT_ID,
                    CUST_ID,
                    ACCT_TYPE,
                    ACCT_STATUS,
                    BALANCE,
                    OD_LIMIT
               FROM BANK_ACCOUNT
              WHERE ACCT_STATUS = 'A'
       END-EXEC.

       EXEC SQL
           SELECT BALANCE
             INTO :WS-DB-BALANCE
             FROM BANK_ACCOUNT
            WHERE ACCT_ID = :WS-DB-ACCOUNT
       END-EXEC.

       EXEC SQL
           UPDATE BANK_ACCOUNT
              SET BALANCE = :WS-DB-NEW-BALANCE
            WHERE ACCT_ID = :WS-DB-ACCOUNT
       END-EXEC.
