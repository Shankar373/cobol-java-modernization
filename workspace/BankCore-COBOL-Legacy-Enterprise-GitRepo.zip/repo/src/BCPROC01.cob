       IDENTIFICATION DIVISION.
       PROGRAM-ID. BCPROC01.

       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT TRANSACTION-IN ASSIGN TO "data/in/transactions.dat"
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS WS-IN-STATUS.

           SELECT ACCOUNT-MASTER ASSIGN TO "data/work/account.dat"
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS ACCT-ID
               FILE STATUS IS WS-ACCT-STATUS.

           SELECT AUDIT-OUT ASSIGN TO "data/out/transaction-audit.dat"
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS WS-AUDIT-STATUS.

           SELECT EXCEPTION-OUT ASSIGN TO "data/out/transaction-exceptions.dat"
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS WS-EXC-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD TRANSACTION-IN.
       01 TXN-LINE PIC X(120).

       FD ACCOUNT-MASTER.
       COPY "copybooks/BC-ACCOUNT.cpy".

       FD AUDIT-OUT.
       01 AUDIT-LINE PIC X(220).

       FD EXCEPTION-OUT.
       01 EXCEPTION-LINE PIC X(220).

       WORKING-STORAGE SECTION.
       COPY "copybooks/BC-TRANSACTION.cpy".
       COPY "copybooks/BC-CONSTANTS.cpy".

       01 WS-IN-STATUS            PIC XX.
       01 WS-ACCT-STATUS          PIC XX.
       01 WS-AUDIT-STATUS         PIC XX.
       01 WS-EXC-STATUS           PIC XX.
       01 WS-EOF                  PIC X VALUE "N".
       01 WS-VALIDATION-STATUS    PIC X.
       01 WS-ERROR-CODE           PIC X(04).
       01 WS-ERROR-TEXT           PIC X(80).
       01 WS-OLD-BALANCE          PIC S9(11)V99 COMP-3.
       01 WS-NEW-BALANCE          PIC S9(11)V99 COMP-3.
       01 WS-TARGET-BALANCE       PIC S9(11)V99 COMP-3.
       01 WS-COUNT-POSTED         PIC 9(7) VALUE ZERO.
       01 WS-COUNT-REJECTED       PIC 9(7) VALUE ZERO.
       01 WS-TOTAL-CREDIT         PIC S9(13)V99 COMP-3 VALUE ZERO.
       01 WS-TOTAL-DEBIT          PIC S9(13)V99 COMP-3 VALUE ZERO.
       01 WS-TOTAL-TRANSFER       PIC S9(13)V99 COMP-3 VALUE ZERO.
       01 WS-NUMERIC-AMOUNT       PIC 9(9)V99.
       01 WS-OUT-AMOUNT            PIC -ZZZ,ZZZ,ZZ9.99.
       01 WS-OUT-BALANCE           PIC -ZZZ,ZZZ,ZZ9.99.
       01 WS-AUDIT-STATUS-TEXT     PIC X(08).
       01 WS-RECORD-COUNT          PIC 9(7) VALUE ZERO.

       01 WS-TXN-RAW.
           05 WS-RAW-ID             PIC X(12).
           05 WS-RAW-DATE           PIC X(08).
           05 WS-RAW-TIME           PIC X(06).
           05 WS-RAW-TYPE           PIC X(01).
           05 WS-RAW-SOURCE         PIC X(10).
           05 WS-RAW-TARGET         PIC X(10).
           05 WS-RAW-AMOUNT         PIC X(12).
           05 WS-RAW-CURRENCY       PIC X(03).
           05 WS-RAW-CHANNEL        PIC X(02).
           05 WS-RAW-REFERENCE      PIC X(20).
           05 WS-RAW-FILLER         PIC X(40).

       PROCEDURE DIVISION.
       MAIN-SECTION.
           PERFORM OPEN-FILES
           PERFORM UNTIL WS-EOF = "Y"
               PERFORM READ-TRANSACTION
               IF WS-EOF NOT = "Y"
                   PERFORM PROCESS-TRANSACTION
               END-IF
           END-PERFORM
           PERFORM CLOSE-FILES
           DISPLAY "PROCESSING COMPLETE. POSTED="
               WS-COUNT-POSTED " REJECTED=" WS-COUNT-REJECTED
           GOBACK.

       OPEN-FILES.
           OPEN INPUT TRANSACTION-IN
           IF WS-IN-STATUS NOT = "00"
               DISPLAY "INPUT OPEN ERROR: " WS-IN-STATUS
               GOBACK
           END-IF
           OPEN I-O ACCOUNT-MASTER
           IF WS-ACCT-STATUS NOT = "00"
               DISPLAY "ACCOUNT OPEN ERROR: " WS-ACCT-STATUS
               GOBACK
           END-IF
           OPEN OUTPUT AUDIT-OUT
           OPEN OUTPUT EXCEPTION-OUT.

       READ-TRANSACTION.
           READ TRANSACTION-IN
               AT END MOVE "Y" TO WS-EOF
           END-READ
           IF WS-EOF NOT = "Y"
               MOVE WS-RAW-ID TO TXN-ID
               MOVE WS-RAW-DATE TO TXN-DATE
               MOVE WS-RAW-TIME TO TXN-TIME
               MOVE WS-RAW-TYPE TO TXN-TYPE
               MOVE WS-RAW-SOURCE TO TXN-SOURCE-ACCT
               MOVE WS-RAW-TARGET TO TXN-TARGET-ACCT
               MOVE WS-RAW-AMOUNT TO TXN-AMOUNT
               MOVE WS-RAW-CURRENCY TO TXN-CURRENCY
               MOVE WS-RAW-CHANNEL TO TXN-CHANNEL
               MOVE WS-RAW-REFERENCE TO TXN-REFERENCE
               ADD 1 TO WS-RECORD-COUNT
           END-IF.

       PROCESS-TRANSACTION.
           MOVE WS-VALID TO WS-VALIDATION-STATUS
           MOVE SPACES TO WS-ERROR-CODE WS-ERROR-TEXT
           EVALUATE TXN-TYPE
               WHEN WS-CREDIT
                   PERFORM POST-CREDIT
               WHEN WS-DEBIT
                   PERFORM POST-DEBIT
               WHEN WS-TRANSFER
                   PERFORM POST-TRANSFER
               WHEN OTHER
                   MOVE WS-INVALID TO WS-VALIDATION-STATUS
                   MOVE "T001" TO WS-ERROR-CODE
                   MOVE "INVALID TRANSACTION TYPE" TO WS-ERROR-TEXT
           END-EVALUATE

           IF WS-VALIDATION-STATUS = WS-VALID
               MOVE "POSTED" TO WS-AUDIT-STATUS-TEXT
               ADD 1 TO WS-COUNT-POSTED
               PERFORM WRITE-AUDIT
           ELSE
               MOVE "REJECTED" TO WS-AUDIT-STATUS-TEXT
               ADD 1 TO WS-COUNT-REJECTED
               PERFORM WRITE-EXCEPTION
           END-IF.

       POST-CREDIT.
           MOVE TXN-SOURCE-ACCT TO ACCT-ID
           READ ACCOUNT-MASTER
           IF WS-ACCT-STATUS NOT = "00"
               MOVE WS-INVALID TO WS-VALIDATION-STATUS
               MOVE "A001" TO WS-ERROR-CODE
               MOVE "SOURCE ACCOUNT NOT FOUND" TO WS-ERROR-TEXT
               EXIT PARAGRAPH
           END-IF
           IF ACCT-STATUS NOT = "A"
               MOVE WS-INVALID TO WS-VALIDATION-STATUS
               MOVE "A002" TO WS-ERROR-CODE
               MOVE "SOURCE ACCOUNT INACTIVE" TO WS-ERROR-TEXT
               EXIT PARAGRAPH
           END-IF
           ADD TXN-AMOUNT TO ACCT-BALANCE
           REWRITE ACCOUNT-RECORD
           ADD TXN-AMOUNT TO WS-TOTAL-CREDIT.

       POST-DEBIT.
           MOVE TXN-SOURCE-ACCT TO ACCT-ID
           READ ACCOUNT-MASTER
           IF WS-ACCT-STATUS NOT = "00"
               MOVE WS-INVALID TO WS-VALIDATION-STATUS
               MOVE "A001" TO WS-ERROR-CODE
               MOVE "SOURCE ACCOUNT NOT FOUND" TO WS-ERROR-TEXT
               EXIT PARAGRAPH
           END-IF
           COMPUTE WS-NEW-BALANCE = ACCT-BALANCE - TXN-AMOUNT
           IF WS-NEW-BALANCE < (0 - ACCT-OD-LIMIT)
               MOVE WS-INVALID TO WS-VALIDATION-STATUS
               MOVE "F001" TO WS-ERROR-CODE
               MOVE "INSUFFICIENT FUNDS / OVERDRAFT LIMIT" TO WS-ERROR-TEXT
               EXIT PARAGRAPH
           END-IF
           MOVE WS-NEW-BALANCE TO ACCT-BALANCE
           REWRITE ACCOUNT-RECORD
           ADD TXN-AMOUNT TO WS-TOTAL-DEBIT.

       POST-TRANSFER.
           IF TXN-SOURCE-ACCT = TXN-TARGET-ACCT
               MOVE WS-INVALID TO WS-VALIDATION-STATUS
               MOVE "T002" TO WS-ERROR-CODE
               MOVE "SOURCE AND TARGET ACCOUNT SAME" TO WS-ERROR-TEXT
               EXIT PARAGRAPH
           END-IF

           MOVE TXN-SOURCE-ACCT TO ACCT-ID
           READ ACCOUNT-MASTER
           IF WS-ACCT-STATUS NOT = "00"
               MOVE WS-INVALID TO WS-VALIDATION-STATUS
               MOVE "A001" TO WS-ERROR-CODE
               MOVE "SOURCE ACCOUNT NOT FOUND" TO WS-ERROR-TEXT
               EXIT PARAGRAPH
           END-IF
           MOVE ACCT-BALANCE TO WS-OLD-BALANCE
           COMPUTE WS-NEW-BALANCE = ACCT-BALANCE - TXN-AMOUNT
           IF WS-NEW-BALANCE < (0 - ACCT-OD-LIMIT)
               MOVE WS-INVALID TO WS-VALIDATION-STATUS
               MOVE "F001" TO WS-ERROR-CODE
               MOVE "TRANSFER WOULD EXCEED OVERDRAFT LIMIT"
                   TO WS-ERROR-TEXT
               EXIT PARAGRAPH
           END-IF

           MOVE TXN-TARGET-ACCT TO ACCT-ID
           READ ACCOUNT-MASTER
           IF WS-ACCT-STATUS NOT = "00"
               MOVE WS-INVALID TO WS-VALIDATION-STATUS
               MOVE "A003" TO WS-ERROR-CODE
               MOVE "TARGET ACCOUNT NOT FOUND" TO WS-ERROR-TEXT
               EXIT PARAGRAPH
           END-IF
           MOVE ACCT-BALANCE TO WS-TARGET-BALANCE
           ADD TXN-AMOUNT TO ACCT-BALANCE
           REWRITE ACCOUNT-RECORD

           MOVE TXN-SOURCE-ACCT TO ACCT-ID
           READ ACCOUNT-MASTER
           MOVE WS-NEW-BALANCE TO ACCT-BALANCE
           REWRITE ACCOUNT-RECORD
           ADD TXN-AMOUNT TO WS-TOTAL-TRANSFER.

       WRITE-AUDIT.
           MOVE SPACES TO AUDIT-LINE
           MOVE TXN-AMOUNT TO WS-NUMERIC-AMOUNT
           MOVE WS-NUMERIC-AMOUNT TO WS-OUT-AMOUNT
           STRING
               TXN-ID DELIMITED BY SIZE
               "|" TXN-DATE DELIMITED BY SIZE
               "|" TXN-TYPE DELIMITED BY SIZE
               "|" TXN-SOURCE-ACCT DELIMITED BY SIZE
               "|" TXN-TARGET-ACCT DELIMITED BY SIZE
               "|" WS-OUT-AMOUNT DELIMITED BY SIZE
               "|" WS-AUDIT-STATUS-TEXT DELIMITED BY SIZE
               "|" TXN-REFERENCE DELIMITED BY SIZE
               INTO AUDIT-LINE
           END-STRING
           WRITE AUDIT-LINE.

       WRITE-EXCEPTION.
           MOVE SPACES TO EXCEPTION-LINE
           STRING
               TXN-ID DELIMITED BY SIZE
               "|" TXN-TYPE DELIMITED BY SIZE
               "|" TXN-SOURCE-ACCT DELIMITED BY SIZE
               "|" TXN-TARGET-ACCT DELIMITED BY SIZE
               "|" WS-ERROR-CODE DELIMITED BY SIZE
               "|" WS-ERROR-TEXT DELIMITED BY SIZE
               "|" TXN-REFERENCE DELIMITED BY SIZE
               INTO EXCEPTION-LINE
           END-STRING
           WRITE EXCEPTION-LINE.

       CLOSE-FILES.
           CLOSE TRANSACTION-IN ACCOUNT-MASTER AUDIT-OUT EXCEPTION-OUT.
