{
  "name": "COBOL-to-Java Modernization Platform (Free Tier)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",

  // Target free-tier 2-core machine only. Do NOT select 4/8/16 cores.
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },

  "features": {
    // JDK 17 (LTS) + Maven 3.9
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installMaven": "true",
      "mavenVersion": "3.9.6"
    }
  },

  "forwardPorts": [8787, 8080, 5432],
  "portsAttributes": {
    "8787": {
      "label": "Modernization Platform UI",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Modernized Spring Boot App",
      "onAutoForward": "silent"
    },
    "5432": {
      "label": "PostgreSQL Database",
      "onAutoForward": "silent"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "vscjava.vscode-java-pack",
        "bitlang.cobol"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "files.trimTrailingWhitespace": true
      }
    }
  },

  // Setup script runs on container build, start, and create
  "updateContentCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/setup.sh",
  "postCreateCommand": "bash .devcontainer/setup.sh"
}
