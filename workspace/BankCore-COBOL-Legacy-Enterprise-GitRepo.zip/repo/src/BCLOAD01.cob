       IDENTIFICATION DIVISION.
       PROGRAM-ID. BCLOAD01.

       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT CUSTOMER-MASTER ASSIGN TO "data/work/customer.dat"
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS CUST-ID
               FILE STATUS IS WS-CUST-STATUS.

           SELECT ACCOUNT-MASTER ASSIGN TO "data/work/account.dat"
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS ACCT-ID
               FILE STATUS IS WS-ACCT-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  CUSTOMER-MASTER.
       COPY "copybooks/BC-CUSTOMER.cpy".

       FD  ACCOUNT-MASTER.
       COPY "copybooks/BC-ACCOUNT.cpy".

       WORKING-STORAGE SECTION.
       01  WS-CUST-STATUS         PIC XX.
       01  WS-ACCT-STATUS         PIC XX.
       01  WS-I                   PIC 99.
       01  WS-DUMMY               PIC X.

       PROCEDURE DIVISION.
       MAIN-SECTION.
           PERFORM INIT-FILES
           PERFORM LOAD-CUSTOMERS
           PERFORM LOAD-ACCOUNTS
           PERFORM CLOSE-FILES
           GOBACK.

       INIT-FILES.
           OPEN OUTPUT CUSTOMER-MASTER
           IF WS-CUST-STATUS NOT = "00" AND WS-CUST-STATUS NOT = "05"
               DISPLAY "CUSTOMER OPEN ERROR: " WS-CUST-STATUS
               GOBACK
           END-IF

           OPEN OUTPUT ACCOUNT-MASTER
           IF WS-ACCT-STATUS NOT = "00" AND WS-ACCT-STATUS NOT = "05"
               DISPLAY "ACCOUNT OPEN ERROR: " WS-ACCT-STATUS
               GOBACK
           END-IF.

       LOAD-CUSTOMERS.
           INITIALIZE CUSTOMER-RECORD
           MOVE "C00001" TO CUST-ID
           MOVE "ARJUN ENTERPRISES" TO CUST-NAME
           MOVE "B" TO CUST-TYPE
           MOVE "A" TO CUST-STATUS
           MOVE "HYDERABAD" TO CUST-CITY
           MOVE "TS" TO CUST-STATE
           MOVE 500000.00 TO CUST-CREDIT-LIMIT
           MOVE 20260115 TO CUST-OPEN-DATE
           WRITE CUSTOMER-RECORD

           INITIALIZE CUSTOMER-RECORD
           MOVE "C00002" TO CUST-ID
           MOVE "SRI LAKSHMI RETAIL" TO CUST-NAME
           MOVE "C" TO CUST-TYPE
           MOVE "A" TO CUST-STATUS
           MOVE "VIJAYAWADA" TO CUST-CITY
           MOVE "AP" TO CUST-STATE
           MOVE 250000.00 TO CUST-CREDIT-LIMIT
           MOVE 20260210 TO CUST-OPEN-DATE
           WRITE CUSTOMER-RECORD

           INITIALIZE CUSTOMER-RECORD
           MOVE "C00003" TO CUST-ID
           MOVE "NEXUS INDUSTRIALS" TO CUST-NAME
           MOVE "B" TO CUST-TYPE
           MOVE "A" TO CUST-STATUS
           MOVE "CHENNAI" TO CUST-CITY
           MOVE "TN" TO CUST-STATE
           MOVE 1000000.00 TO CUST-CREDIT-LIMIT
           MOVE 20260320 TO CUST-OPEN-DATE
           WRITE CUSTOMER-RECORD.

       LOAD-ACCOUNTS.
           INITIALIZE ACCOUNT-RECORD
           MOVE "AC00000001" TO ACCT-ID
           MOVE "C00001" TO ACCT-CUST-ID
           MOVE "CA" TO ACCT-TYPE
           MOVE "A" TO ACCT-STATUS
           MOVE "INR" TO ACCT-CURRENCY
           MOVE 150000.00 TO ACCT-BALANCE
           MOVE 25000.00 TO ACCT-OD-LIMIT
           MOVE 20260115 TO ACCT-OPEN-DATE
           WRITE ACCOUNT-RECORD

           INITIALIZE ACCOUNT-RECORD
           MOVE "AC00000002" TO ACCT-ID
           MOVE "C00001" TO ACCT-CUST-ID
           MOVE "SA" TO ACCT-TYPE
           MOVE "A" TO ACCT-STATUS
           MOVE "INR" TO ACCT-CURRENCY
           MOVE 75000.00 TO ACCT-BALANCE
           MOVE 0.00 TO ACCT-OD-LIMIT
           MOVE 20260115 TO ACCT-OPEN-DATE
           WRITE ACCOUNT-RECORD

           INITIALIZE ACCOUNT-RECORD
           MOVE "AC00000003" TO ACCT-ID
           MOVE "C00002" TO ACCT-CUST-ID
           MOVE "CA" TO ACCT-TYPE
           MOVE "A" TO ACCT-STATUS
           MOVE "INR" TO ACCT-CURRENCY
           MOVE 50000.00 TO ACCT-BALANCE
           MOVE 10000.00 TO ACCT-OD-LIMIT
           MOVE 20260210 TO ACCT-OPEN-DATE
           WRITE ACCOUNT-RECORD

           INITIALIZE ACCOUNT-RECORD
           MOVE "AC00000004" TO ACCT-CUST-ID
           MOVE "C00003" TO ACCT-CUST-ID
           MOVE "CA" TO ACCT-TYPE
           MOVE "A" TO ACCT-STATUS
           MOVE "INR" TO ACCT-CURRENCY
           MOVE 500000.00 TO ACCT-BALANCE
           MOVE 50000.00 TO ACCT-OD-LIMIT
           MOVE 20260320 TO ACCT-OPEN-DATE
           WRITE ACCOUNT-RECORD.

       CLOSE-FILES.
           CLOSE CUSTOMER-MASTER ACCOUNT-MASTER.
