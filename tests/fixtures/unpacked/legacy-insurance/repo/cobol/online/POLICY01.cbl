IDENTIFICATION DIVISION.
PROGRAM-ID. POLICY01.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY POLICY.
PROCEDURE DIVISION.
    DISPLAY "POLICY INQUIRY".
    EXEC CICS RECEIVE MAP('POLICYMP') END-EXEC.
    EXEC SQL
        SELECT POLICY_ID, STATUS, COVER_LIMIT
          INTO :POLICY-ID, :POLICY-STATUS, :POLICY-COVER
          FROM POLICY
         WHERE POLICY_ID = :POLICY-ID
    END-EXEC.
    EXEC CICS SEND MAP('POLICYMP') END-EXEC.
    EXEC CICS RETURN END-EXEC.
    GOBACK.
